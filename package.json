    "@tabler/icons-svelte": "^3.50.0",
    "@tableslayer/ui": "0.2.8",
    "@threlte/core": "^8.6.1",
    "@threlte/extras": "^9.23.0",
    "@zip.js/zip.js": "^2.24.0",
    "jspdf": "^4.2.1",
    "marked": "^18.1.2",
    "mode-watcher": "^1.1.0",
    "paneforge": "^1.0.2",
